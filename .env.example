# ── Application Under Test ─────────────────────────────────────────────
BASE_URL=https://your-app.example.com
HEADLESS=true

# ── Credentials (never commit .env) ─────────────────────────────────────
TEST_USERNAME=your.username@example.com
TEST_PASSWORD=your_password_here

# ── SSO / OAuth ──────────────────────────────────────────────────────────
# Set to path of storageState file after running: npm run auth:login
AUTH_STATE_PATH=.auth/user.json
SSO_BASE_URL=https://sso.example.com

# ── External services ────────────────────────────────────────────────────
API_BASE_URL=https://api.example.com
API_TOKEN=your_api_token_here

# ── CI flags ─────────────────────────────────────────────────────────────
CI=false
SKIP_AUTH=true
